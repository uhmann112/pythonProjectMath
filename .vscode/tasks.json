        {
      "label": "git pull on open",
      "type": "shell",
      "command": "if (Test-Path .git) { git pull --ff-only }",
      "runOptions": { "runOn": "folderOpen" },
      "presentation": {
        "reveal": "always",
        "close": false,
        "panel": "dedicated",
        "focus": false
        }
    }
    ]
